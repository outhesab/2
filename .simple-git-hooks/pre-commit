#!/bin/sh
# pre-commit hook: changelog.ts güncellemesini zorunlu kılar

CHANGELOG="src/lib/changelog.ts"
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)

# changelog.ts zaten güncellenmişse geç
echo "$CHANGED" | grep -q "$CHANGELOG" && exit 0

# Kaynak kod değişikliği var mı?
SOURCE=$(echo "$CHANGED" | grep -E '\.(ts|tsx|js|jsx|css|html|json)$' | grep -v 'node_modules' | grep -v 'dist' | head -1)

if [ -n "$SOURCE" ]; then
  echo ""
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  ❌ COMMIT REDDEDİLDİ                                      ║"
  echo "║  src/lib/changelog.ts güncellenmemiş!                      ║"
  echo "║                                                             ║"
  echo "║  Önce değişiklikleri changelog.ts dosyasına ekleyin:        ║"
  echo "║    { type: 'yeni',        text: '...' }                    ║"
  echo "║    { type: 'iyilestirme', text: '...' }                    ║"
  echo "║    { type: 'duzeltme',    text: '...' }                    ║"
  echo "║    { type: 'kaldirildi',  text: '...' }                    ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  echo ""
  exit 1
fi

exit 0
