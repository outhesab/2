# Normalize to LF on commit, keep LF on checkout
*.ts text eol=lf working-tree-encoding=UTF-8
*.tsx text eol=lf working-tree-encoding=UTF-8
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.jar binary
*.bin binary
*.lock binary
