{
  "name": "parspel",
  "version": "3.23.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 100",
    "lint:fix": "eslint src --fix",
    "lint:fallow": "fallow audit",
    "lint:fallow:all": "fallow",
    "lint:fallow:health": "fallow health --score",
    "lint:fallow:deadcode": "fallow dead-code",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:specs": "vitest run src/__tests__/spec-compliance.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:axe": "playwright test --project=chromium e2e/accessibility.spec.ts",
    "test:lighthouse": "node -e \"import('./e2e/helpers/lighthouse.ts').then(m => m.runLighthouse('http://localhost:3000').then(r => console.log(JSON.stringify(r.scores, null, 2))))\"",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "cap:android": "vite build && pnpm exec cap sync android && pnpm exec cap open android",
    "cap:apk:dev": "vite build --mode development && pnpm exec cap sync android && cd android && ./gradlew assembleDebug --build-cache --parallel",
    "cap:apk:release": "vite build && pnpm exec cap sync android && cd android && ./gradlew assembleRelease --build-cache --parallel",
    "cap:apk:fast": "vite build --mode development --emptyOutDir && pnpm exec cap sync android && cd android && ./gradlew assembleDebug --build-cache --parallel --offline",
    "build:apk": "pnpm install --frozen-lockfile && pnpm run build && pnpm exec cap sync android && cd android && ./gradlew assembleDebug --no-daemon --stacktrace",
    "build:check": "pnpm install --no-frozen-lockfile && pnpm run lint && pnpm run typecheck && pnpm run test:run && pnpm run build",
    "prepare": "simple-git-hooks",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "echo ok",
    "analyze": "pnpm build --mode analyze && start dist\\\\stats.html",
    "coverage:ui": "vitest run --coverage --reporter=html && start coverage/index.html",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^7.0.3",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-accordion": "^1.2.7",
    "@radix-ui/react-alert-dialog": "^1.1.10",
    "@radix-ui/react-aspect-ratio": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.1.6",
    "@radix-ui/react-context-menu": "^2.2.10",
    "@radix-ui/react-dialog": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.10",
    "@radix-ui/react-hover-card": "^1.1.8",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-menubar": "^1.1.10",
    "@radix-ui/react-navigation-menu": "^1.2.7",
    "@radix-ui/react-popover": "^1.1.8",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-radio-group": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@radix-ui/react-select": "^2.1.10",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slider": "^1.2.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-switch": "^1.1.6",
    "@radix-ui/react-tabs": "^1.1.6",
    "@radix-ui/react-toast": "^1.2.10",
    "@radix-ui/react-toggle": "^1.1.4",
    "@radix-ui/react-toggle-group": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@types/dompurify": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "dexie": "^4.0.11",
    "dompurify": "^3.4.7",
    "firebase": "^12.13.0",
    "framer-motion": "^12.40.0",
    "input-otp": "^1.0.0",
    "lightningcss": "^1.32.0",
    "lucide-react": "^0.487.0",
    "mitt": "^3.0.1",
    "react": "^19.2.6",
    "react-day-picker": "^9.0.0",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.0.0",
    "react-resizable-panels": "^2.0.0",
    "recharts": "^2.15.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.2.0",
    "vaul": "^1.1.2",
    "wouter": "^3.6.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "fallow"
    ],
    "updateConfig": {
      "autoinstall": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^9.25.1",
    "@playwright/mcp": "^0.0.76",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fallow": "^0.1.5",
    "fast-check": "^4.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.0",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "lint-staged": "^17.0.7",
    "playwright": "^1.52.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.0",
    "react-scan": "^0.5.7",
    "rollup-plugin-visualizer": "^7.0.1",
    "simple-git-hooks": "^2.13.1",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.4",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.2"
  }
}
