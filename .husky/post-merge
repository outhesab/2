#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/helpers/colors.sh"

print_header "🔄 POST-MERGE TASKS"

# 1. LOCK FILE KONTROL
print_step "Checking lock file changes"

if git diff --name-only HEAD@{1} HEAD | grep -q "pnpm-lock.yaml"; then
  print_info "pnpm-lock.yaml changed in merge"
  print_step "Installing dependencies..."
  
  if pnpm install > /dev/null 2>&1; then
    print_success "Dependencies installed"
  else
    print_error "Dependency installation failed"
    exit 1
  fi
else
  print_success "No lock file changes"
fi

# 2. PACKAGE.JSON KONTROL
print_step "Checking package.json changes"

if git diff --name-only HEAD@{1} HEAD | grep -q "package.json"; then
  print_warning "package.json changed - verify changes"
else
  print_success "No package.json changes"
fi

# 3. TYPESCRIPT CONFIG KONTROL
print_step "Checking TypeScript config"

if git diff --name-only HEAD@{1} HEAD | grep -qE "(tsconfig|vite.config)"; then
  print_warning "Build configuration changed"
  print_info "Run: pnpm run build to verify"
else
  print_success "No build config changes"
fi

# 4. BRANCH DETECTION
print_step "Detecting merge source"

MERGE_MSG=$(cat .git/MERGE_MSG 2>/dev/null || echo "")
if [[ "$MERGE_MSG" =~ Merge\ pull\ request\ #([0-9]+) ]]; then
  PR_NUM=${BASH_REMATCH[1]}
  print_info "Merged PR #$PR_NUM"
fi

print_success "Post-merge tasks complete"
exit 0
