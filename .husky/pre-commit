#!/bin/sh
. "$(dirname -- "$0")/_/husky.sh"

# Lockfile sync kontrolü
if git diff --cached --name-only | grep -q "package.json"; then
  echo "📦 package.json değişti — lockfile senkronize ediliyor..."
  pnpm install --frozen-lockfile=false
  git add pnpm-lock.yaml
fi

# Changelog kontrolü (mevcut hook)
CHANGELOG="src/lib/changelog.ts"
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)
echo "$CHANGED" | grep -q "$CHANGELOG" && exit 0
SOURCE=$(echo "$CHANGED" | grep -E '\.(ts|tsx|js|jsx|css|html|json)$' | grep -v 'node_modules' | grep -v 'dist' | head -1)

if [ -n "$SOURCE" ]; then
  echo ""
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  ❌ COMMIT REDDEDİLDİ                                      ║"
  echo "║  src/lib/changelog.ts güncellenmemiş!                      ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  echo ""
  exit 1
fi

exit 0
