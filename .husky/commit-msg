#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/helpers/colors.sh"
source "$SCRIPT_DIR/helpers/git-context.sh"

MSG_FILE="$1"
COMMIT_MSG=$(cat "$MSG_FILE")

print_header "📝 COMMIT MESSAGE VALIDATION"

# WIP commit'leri izin ver
if [[ "$COMMIT_MSG" =~ ^WIP ]]; then
  print_warning "WIP commit - skipping validation"
  exit 0
fi

# Merge commit'lerini skip et
if [[ "$COMMIT_MSG" =~ ^Merge ]]; then
  exit 0
fi

# 1. FORMAT KONTROL
print_step "Format validation"

# Conventional Commits regex
if ! echo "$COMMIT_MSG" | grep -qE "^(feat|fix|chore|docs|style|refactor|test|perf|ci|build|revert)(\(.+\))?!?: .{1,}"; then
  print_error "Invalid format!"
  echo ""
  echo -e "${CYAN}Expected format:${NC}"
  echo "  feat(scope): Add new feature"
  echo "  fix: Resolve memory leak"
  echo "  chore: Update dependencies"
  echo ""
  echo -e "${CYAN}Commit types:${NC}"
  echo "  feat     - New feature"
  echo "  fix      - Bug fix"
  echo "  chore    - Maintenance"
  echo "  docs     - Documentation"
  echo "  style    - Code style"
  echo "  refactor - Code refactor"
  echo "  test     - Tests"
  echo "  perf     - Performance"
  echo "  ci       - CI/CD"
  exit 1
fi

print_success "Format valid"

# 2. UZUNLUK KONTROL
print_step "Length validation"

# Subject line (ilk satır) 72 karakterden uzun olmasın
SUBJECT=$(echo "$COMMIT_MSG" | head -n1)
SUBJECT_LEN=${#SUBJECT}

if [ $SUBJECT_LEN -lt 8 ]; then
  print_error "Subject too short (minimum 8 characters)"
  exit 1
fi

if [ $SUBJECT_LEN -gt 72 ]; then
  print_warning "Subject line is ${SUBJECT_LEN} characters (recommended: ≤72)"
  # Uyarı ver ama izin ver
fi

print_success "Length valid"

# 3. SCOPE KONTROL
print_step "Scope validation"

SCOPE=$(echo "$SUBJECT" | grep -oP '(?<=\()\w+(?=\))' || echo "")

if [ -n "$SCOPE" ]; then
  VALID_SCOPES=("core" "ui" "api" "db" "agents" "tests" "build" "ci" "docs" "deps")
  VALID=0
  
  for valid_scope in "${VALID_SCOPES[@]}"; do
    if [ "$SCOPE" = "$valid_scope" ]; then
      VALID=1
      break
    fi
  done
  
  if [ $VALID -eq 0 ]; then
    print_warning "Non-standard scope: $SCOPE (valid: core, ui, api, db, agents, tests, build, ci, docs, deps)"
  else
    print_success "Scope valid: $SCOPE"
  fi
else
  print_info "No scope specified (optional)"
fi

# 4. BODY KONTROL
print_step "Body structure"

LINES=$(echo "$COMMIT_MSG" | wc -l)

if [ $LINES -gt 1 ]; then
  SECOND_LINE=$(echo "$COMMIT_MSG" | sed -n '2p')
  
  if [ -n "$SECOND_LINE" ]; then
    print_error "Second line must be blank (separate subject from body)"
    exit 1
  fi
  
  print_success "Body structure valid"
else
  print_info "No body (single-line commit)"
fi

# 5. ISSUE REFERENCE (optional)
print_step "Issue reference check"

if echo "$COMMIT_MSG" | grep -qE "(Closes|Fixes|Resolves) #[0-9]+"; then
  ISSUE=$(echo "$COMMIT_MSG" | grep -oP '(Closes|Fixes|Resolves) #\K[0-9]+')
  print_success "Issue referenced: #$ISSUE"
else
  print_info "No issue reference (optional)"
fi

# SONUÇ
echo ""
print_success "Commit message validated!"
print_info "Subject: $SUBJECT"

exit 0
