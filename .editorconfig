# PARSPEL — EditorConfig
# Tüm editörlerde tutarlı kodlama sağlar

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,jsx,json,css,html,md,yml,yaml}]
indent_size = 2

[*.{py,rb,java}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.svg]
indent_size = 2
